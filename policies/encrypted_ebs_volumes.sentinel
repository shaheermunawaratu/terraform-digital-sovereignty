import "tfplan/v2" as tfplan

# Identify EC2 instances that remain after proposed changes.
ec2_instances = filter tfplan.resource_changes as address, resource {
  resource.mode is "managed" and
  resource.type is "aws_instance" and
  resource.change.after is not null
}

# Identify separately managed EBS volumes.
ebs_volumes = filter tfplan.resource_changes as address, resource {
  resource.mode is "managed" and
  resource.type is "aws_ebs_volume" and
  resource.change.after is not null
}

# Every EC2 root volume must be encrypted.
encrypted_root_volumes = rule {
  all ec2_instances as address, instance {
    all instance.change.after.root_block_device as device {
      device.encrypted is true
    }
  }
}

# Every separately managed EBS volume must be encrypted.
encrypted_data_volumes = rule {
  all ebs_volumes as address, volume {
    volume.change.after.encrypted is true
  }
}

# Enforce encryption across both EBS storage types.
main = rule {
  encrypted_root_volumes and encrypted_data_volumes
}
